# Copy to .env and fill in. Never commit .env.

# Service principal that has SELECT + MODIFY on accessdemo.fluentbit.helix_otel_logs
DATABRICKS_CLIENT_ID=
DATABRICKS_CLIENT_SECRET=

# fevm-ai workspace (Zerobus OTLP gRPC)
DATABRICKS_HOST=https://fevm-serverless-stable-2xts9s.cloud.databricks.com
WORKSPACE_ID=7474654402210824
# AWS region of the workspace (Zerobus hostname segment)
REGION=us-east-1

DATABRICKS_LOGS_TABLE=accessdemo.fluentbit.helix_otel_logs

# Filled by scripts/mint_zerobus_token.py (1 hour TTL)
DATABRICKS_OTLP_TOKEN=

# Local generator / Fluent Bit
LOG_PATH=logs/otel.jsonl
FLB_DB_PATH=logs/flb.db
